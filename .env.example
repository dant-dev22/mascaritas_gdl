# Plantilla de variables de entorno. Copia este archivo a `.env.local` y
# rellena los valores. Ninguna credencial vive en el repositorio.

# URL del backend FastAPI. En local apunta al servidor de desarrollo; en el VPS
# al proceso de la API.
BACKEND_URL=http://127.0.0.1:8000

# Píxel de Meta (Facebook e Instagram). Es el único píxel del sitio.
# Sin ID el píxel no se monta, que es el comportamiento esperado en desarrollo.
# Es NEXT_PUBLIC_*: se hornea en build, así que cambiarlo exige reconstruir.
NEXT_PUBLIC_META_PIXEL_ID=
